# --- 접속 제어 (바우처 코드) ---
# 쉼표로 구분한 유효한 바우처 코드. 미설정 시 초기 코드 1234가 사용된다 (운영에서는 반드시 변경).
# VOUCHER_CODES=1234
# 세션 쿠키 서명 키. 운영 환경(NODE_ENV=production)에서는 필수이며, 없으면 접속이 모두 거부된다.
# 예: openssl rand -hex 32
# ACCESS_SECRET=

# --- 이후 단계에서 사용할 예정 ---
# DATABASE_URL=postgres://user:pass@host/db        # Phase 2: Neon PostgreSQL
# BLOB_READ_WRITE_TOKEN=                           # Phase 2: Vercel Blob (비공개 업로드)
# OPENAI_API_KEY=                                  # Phase 3: 서버에서만 사용, 브라우저에 노출 금지
# CONNECTION_SECRET_KEY=                           # Phase 3: 저장된 API 인증 정보 암호화 키
